<%- include('partials/header') %>

<main>
    <div class="page-header">
        <div>
            <h1>Upcoming Service Projects</h1>
            <p class="upcoming-note">Showing the next <%= projects ? projects.length : 0 %> upcoming projects.</p>
        </div>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/new-project" class="btn btn-success btn-sm">
                <i class="fas fa-plus-circle"></i> Add New Project
            </a>
        <% } %>
    </div>
    
    <div class="projects-header">
        <p>Discover service opportunities in your community. Join us in making a difference!</p>
    </div>
    
    <% if (projects && projects.length > 0) { %>
        <div class="project-list">
            <% projects.forEach(project => { %>
                <div class="project-card">
                    <div class="project-header">
                        <h3>
                            <a href="/project/<%= project.project_id %>" class="project-link">
                                <%= project.title %>
                            </a>
                        </h3>
                        <span class="project-date-badge">
                            <i class="fas fa-calendar-alt"></i>
                            <%= formatDate(project.project_date) %>
                        </span>
                    </div>
                    
                    <div class="project-organization">
                        <span class="org-label">Organization:</span>
                        <a href="/organization/<%= project.organization_id %>" class="org-link">
                            <%= project.organization_name %>
                        </a>
                    </div>
                    
                    <p class="project-description"><%= project.description %></p>
                    
                    <div class="project-details">
                        <div class="detail-item">
                            <span class="detail-icon">📍</span>
                            <span class="detail-text"><%= project.location %></span>
                        </div>
                    </div>
                    
                    <div class="project-actions">
                        <a href="/project/<%= project.project_id %>" class="btn btn-primary">
                            View Details <i class="fas fa-arrow-right"></i>
                        </a>
                        <a href="/organization/<%= project.organization_id %>" class="btn btn-secondary">
                            <i class="fas fa-building"></i> View Organization
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <div class="project-count">
            <p>Showing <%= projects.length %> upcoming project<%= projects.length > 1 ? 's' : '' %></p>
        </div>
    <% } else { %>
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <h3>No Upcoming Projects</h3>
            <p>There are currently no upcoming service projects.</p>
            <% if (user && user.role_name === 'admin') { %>
                <p><a href="/new-project">Add a new project</a> to get started!</p>
            <% } %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>