<%- include('partials/header') %>

<main>
    <div class="page-header">
        <div>
            <h1>Service Categories</h1>
            <p>Browse service opportunities by category. Find the perfect way to make a difference in your community!</p>
        </div>
        <a href="/new-category" class="btn btn-success btn-sm">
            <i class="fas fa-plus-circle"></i> Add New Category
        </a>
    </div>
    
    <div class="categories-header">
        <p>Browse service opportunities by category. Find the perfect way to make a difference in your community!</p>
    </div>
    
    <% if (categories && categories.length > 0) { %>
        <div class="categories-grid">
            <% categories.forEach(category => { %>
                <div class="category-card">
                    <div class="category-icon">
                        <i class="<%= category.icon_class || 'fas fa-tag' %>"></i>
                    </div>
                    <div class="category-content">
                        <h3><%= category.name %></h3>
                        <p><%= category.description || 'No description available' %></p>
                        <div class="category-meta">
                            <span class="project-count">
                                <i class="fas fa-project-diagram"></i>
                                <%= category.project_count || 0 %> projects
                            </span>
                            <span class="category-status <%= category.is_active ? 'active' : 'inactive' %>">
                                <%= category.is_active ? 'Active' : 'Inactive' %>
                            </span>
                        </div>
                        <div class="category-actions">
                            <a href="/category/<%= category.category_id %>" class="btn btn-primary btn-sm">
                                <i class="fas fa-eye"></i> View Projects
                            </a>
                            <a href="/edit-category/<%= category.category_id %>" class="btn btn-secondary btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <div class="category-count">
            <p>Total Categories: <%= categories.length %></p>
        </div>
    <% } else { %>
        <div class="empty-state">
            <div class="empty-icon">🏷️</div>
            <h3>No Categories Available</h3>
            <p>There are currently no categories available.</p>
            <a href="/new-category" class="btn btn-success">Add a New Category</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>