<!-- ============================================
     Header Partial
     Included at the top of every page
     ============================================ -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - CSE 340 Service Network</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav>
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="brand-link">
                    <img src="/Image/cse340-service-network.png" 
                         alt="CSE 340 Service Network Logo" 
                         class="nav-logo"
                         onerror="this.style.display='none'">
                    <span class="brand-text">CSE 340 Service Network</span>
                </a>
            </div>
            <ul class="nav-links">
                <li><a href="/"><i class="fas fa-home"></i> Home</a></li>
                <li><a href="/organizations"><i class="fas fa-building"></i> Organizations</a></li>
                <li><a href="/projects"><i class="fas fa-project-diagram"></i> Projects</a></li>
                <li><a href="/categories"><i class="fas fa-tags"></i> Categories</a></li>
                <% if (isLoggedIn) { %>
                    <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                    <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                <% } else { %>
                    <li><a href="/register"><i class="fas fa-user-plus"></i> Register</a></li>
                    <li><a href="/login"><i class="fas fa-sign-in-alt"></i> Login</a></li>
                <% } %>
            </ul>
        </div>
    </nav>

    <!-- Flash Messages -->
    <div class="flash-messages">
        <% const flashData = flash(); %>
        <% Object.keys(flashData).forEach(function(type) { %>
            <% if (flashData[type].length > 0) { %>
                <div class="alert alert-<%= type %>">
                    <i class="fas <%= 
                        type === 'success' ? 'fa-check-circle' : 
                        type === 'error' ? 'fa-exclamation-circle' : 
                        type === 'warning' ? 'fa-exclamation-triangle' : 
                        'fa-info-circle' 
                    %>"></i>
                    <div class="alert-messages">
                        <% flashData[type].forEach(function(msg) { %>
                            <p><%= msg %></p>
                        <% }); %>
                    </div>
                    <button class="alert-close" onclick="this.parentElement.style.display='none'">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            <% } %>
        <% }); %>
    </div>