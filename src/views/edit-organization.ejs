<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <div class="form-container">
        <p class="form-instructions">Update the organization details below.</p>
        
        <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="organization-form" novalidate>
            <input type="hidden" name="organizationId" value="<%= organizationDetails.organization_id %>" />
            
            <div class="form-group">
                <label for="name">Organization Name <span class="required">*</span></label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= organizationDetails.name %>"
                    required
                    maxlength="150"
                />
                <span class="field-note">Must be between 3 and 150 characters.</span>
                <div class="error-message" id="nameError"></div>
            </div>

            <div class="form-group">
                <label for="description">Description <span class="required">*</span></label>
                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    required
                    maxlength="500"
                ><%= organizationDetails.description %></textarea>
                <span class="field-note">Maximum 500 characters. <span id="charCount"><%= organizationDetails.description ? organizationDetails.description.length : 0 %></span>/500</span>
                <div class="error-message" id="descriptionError"></div>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email <span class="required">*</span></label>
                <input
                    type="email"
                    id="contactEmail"
                    name="contactEmail"
                    value="<%= organizationDetails.contact_email %>"
                    required
                />
                <span class="field-note">This email will be displayed on the organization's public page.</span>
                <div class="error-message" id="emailError"></div>
            </div>

            <div class="form-group">
                <label for="logoFilename">Logo Filename</label>
                <input
                    type="text"
                    id="logoFilename"
                    name="logoFilename"
                    value="<%= organizationDetails.logo_filename %>"
                    placeholder="logo-filename.png"
                />
                <span class="field-note">Filename of the organization's logo image in /public/images/</span>
                <div class="error-message" id="logoError"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update Organization
                </button>
                <a href="/organization/<%= organizationDetails.organization_id %>" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
        
        <div class="form-footer">
            <p>All fields marked with <span class="required">*</span> are required.</p>
            <p>Changes will be saved to the database and visible immediately.</p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>