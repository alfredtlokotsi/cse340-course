<%- include('partials/header') %>

<main>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1><%= title %></h1>
            <div class="dashboard-welcome">
                <i class="fas fa-user-circle"></i>
                <span>Welcome back, <strong><%= name %></strong>!</span>
            </div>
        </div>

        <div class="dashboard-content">
            <div class="dashboard-card">
                <h2><i class="fas fa-user"></i> Your Profile</h2>
                <div class="profile-info">
                    <div class="profile-item">
                        <span class="profile-label">Name:</span>
                        <span class="profile-value"><%= name %></span>
                    </div>
                    <div class="profile-item">
                        <span class="profile-label">Email:</span>
                        <span class="profile-value"><%= email %></span>
                    </div>
                </div>
            </div>

            <div class="dashboard-card">
                <h2><i class="fas fa-cog"></i> Quick Actions</h2>
                <div class="quick-actions">
                    <a href="/organizations" class="btn btn-primary btn-sm">
                        <i class="fas fa-building"></i> View Organizations
                    </a>
                    <a href="/projects" class="btn btn-primary btn-sm">
                        <i class="fas fa-project-diagram"></i> View Projects
                    </a>
                    <a href="/categories" class="btn btn-primary btn-sm">
                        <i class="fas fa-tags"></i> View Categories
                    </a>
                </div>
            </div>

            <div class="dashboard-card">
                <h2><i class="fas fa-info-circle"></i> Account Information</h2>
                <p>You are logged in as a registered user.</p>
                <p>Account created: <span class="account-date"><%= new Date().toLocaleDateString() %></span></p>
                <a href="/logout" class="btn btn-danger btn-sm">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>

            <!-- Admin Only Section -->
            <% if (user && user.role_name === 'admin') { %>
                <div class="dashboard-card admin-card">
                    <h2><i class="fas fa-shield-alt"></i> Admin Tools</h2>
                    <div class="quick-actions">
                        <a href="/users" class="btn btn-info btn-sm">
                            <i class="fas fa-users"></i> Manage Users
                        </a>
                        <a href="/new-organization" class="btn btn-success btn-sm">
                            <i class="fas fa-plus-circle"></i> Add Organization
                        </a>
                        <a href="/new-project" class="btn btn-success btn-sm">
                            <i class="fas fa-plus-circle"></i> Add Project
                        </a>
                        <a href="/new-category" class="btn btn-success btn-sm">
                            <i class="fas fa-plus-circle"></i> Add Category
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>