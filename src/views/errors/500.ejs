<%- include('../partials/header') %>

<main>
    <div class="error-container error-500">
        <div class="error-icon">⚠️</div>
        <h1>500 - Server Error</h1>
        <h2>Something Went Wrong</h2>
        <p>We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
        <p>Please try again later.</p>
        
        <div class="error-actions">
            <a href="/" class="btn btn-primary">
                <i class="fas fa-home"></i> Return to Home
            </a>
            <a href="javascript:location.reload()" class="btn btn-secondary">
                <i class="fas fa-sync"></i> Try Again
            </a>
        </div>
        
        <% if (NODE_ENV === 'development') { %>
            <div class="error-details">
                <h3>🔧 Error Details (Development Only)</h3>
                <p><strong>Status:</strong> <%= status || 500 %></p>
                <p><strong>Message:</strong> <%= error || 'Unknown error' %></p>
                <p><strong>Timestamp:</strong> <%= timestamp %></p>
                <% if (stack) { %>
                    <details open>
                        <summary>Stack Trace</summary>
                        <pre><%= stack %></pre>
                    </details>
                <% } %>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>