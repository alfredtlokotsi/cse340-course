<%- include('partials/header') %>

<main>
    <div class="auth-container">
        <h1>Create an Account</h1>
        
        <div class="auth-form-container">
            <p class="form-instructions">Join the CSE 340 Service Network and start making a difference in your community.</p>
            
            <form action="/register" method="POST" class="auth-form" novalidate>
                <div class="form-group">
                    <label for="name">Full Name <span class="required">*</span></label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="e.g., John Smith"
                        required
                        maxlength="100"
                    />
                    <span class="field-note">Must be between 2 and 100 characters.</span>
                    <div class="error-message" id="nameError"></div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address <span class="required">*</span></label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="e.g., john@example.com"
                        required
                    />
                    <span class="field-note">We'll never share your email with anyone else.</span>
                    <div class="error-message" id="emailError"></div>
                </div>

                <div class="form-group">
                    <label for="password">Password <span class="required">*</span></label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a strong password"
                        required
                        minlength="4"
                    />
                    <span class="field-note">Must be at least 4 characters with uppercase, lowercase, and a number.</span>
                    <div class="error-message" id="passwordError"></div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-user-plus"></i> Create Account
                    </button>
                    <a href="/" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
            
            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Login here</a></p>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>