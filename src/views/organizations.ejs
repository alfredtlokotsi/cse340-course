<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <div class="page-header">
        <p>Here are a few of our partner organizations:</p>
        <a href="/new-organization" class="btn btn-success btn-sm">
            <i class="fas fa-plus-circle"></i> Add New Organization
        </a>
    </div>
    
    <ul class="organization-list">
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <li>
                    <img src="/images/<%= org.logo_filename %>" 
                         alt="<%= org.name %> logo"
                         onerror="this.src='/images/placeholder-logo.png'">
                    <div>
                        <a href="/organization/<%= org.organization_id %>" class="org-link">
                            <strong><%= org.name %></strong>
                        </a>
                        <p><%= org.description %></p>
                        <span><%= org.contact_email %></span>
                    </div>
                </li>
            <% }); %>
        <% } else { %>
            <li>No organizations found. <a href="/new-organization">Add one now!</a></li>
        <% } %>
    </ul>
    
    <div class="organization-count">
        <p>Total Organizations: <%= organizations ? organizations.length : 0 %></p>
    </div>
</main>

<%- include('partials/footer') %>
